@page "/Auth/Login"
@model ChatBot.Pages.Auth.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Login - RAG ChatBot</title>
    <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: linear-gradient(135deg, #f9e7b6, #f8f8f8);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                width: 420px;
                background: white;
                border-radius: 20px;
                padding: 36px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            }

            .tag {
                display: inline-block;
                background: #fff2c6;
                color: #b8860b;
                padding: 8px 14px;
                border-radius: 999px;
                font-size: 13px;
                font-weight: bold;
                margin-bottom: 18px;
            }

            h1 {
                margin: 0 0 8px;
                font-size: 32px;
            }

            p {
                color: #666;
                margin-bottom: 28px;
            }

            label {
                display: block;
                font-weight: bold;
                margin-bottom: 8px;
                margin-top: 16px;
            }

            input {
                width: 100%;
                padding: 13px 14px;
                border: 1px solid #ddd;
                border-radius: 12px;
                font-size: 15px;
                box-sizing: border-box;
            }

            button {
                width: 100%;
                margin-top: 24px;
                padding: 14px;
                background: #f4c542;
                border: none;
                border-radius: 12px;
                font-weight: bold;
                cursor: pointer;
                font-size: 16px;
            }

                button:hover {
                    background: #e5b72f;
                }

            .error {
                margin-top: 16px;
                padding: 12px;
                background: #ffe5e5;
                color: #b00020;
                border-radius: 10px;
                font-size: 14px;
            }

            .field-error {
                color: #b00020;
                font-size: 13px;
                margin-top: 5px;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="tag">RAG CHATBOT</div>

        <h1>Đăng nhập</h1>
        <p>Đăng nhập để sử dụng hệ thống quản lý tài liệu và hỏi đáp AI.</p>

        <form method="post">
            @Html.AntiForgeryToken()

            <label>Email</label>
            <input asp-for="Input.Email" placeholder="Nhập email" />
            <div class="field-error">
                <span asp-validation-for="Input.Email"></span>
            </div>

            <label>Mật khẩu</label>
            <input asp-for="Input.Password" type="password" placeholder="Nhập mật khẩu" />
            <div class="field-error">
                <span asp-validation-for="Input.Password"></span>
            </div>

            <button type="submit">Đăng nhập</button>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="error">@Model.Error</div>
            }
        </form>

        <div style="margin-top:12px; text-align:center;">
            <a asp-page="/Auth/Register">Chưa có tài khoản? Đăng ký</a>
        </div>
    </div>
</body>
</html>