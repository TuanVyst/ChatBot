@page "{id}"
@model ChatBot.Pages.Admin.AddStudentToSubjectModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Student to Subject";
}

<div class="admin-header">
    <h1 class="page-title">Add Student to @Model.Subject.Name</h1>

    <div class="admin-actions">
        <a asp-page="/Admin/Subjects"
           class="btn-secondary btn-premium">
            Back to List
        </a>
    </div>
</div>

<div class="admin-card" style="max-width:600px;">
    <form method="post">

        <input type="hidden" asp-for="SubjectId" />

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email"
                   class="form-control"
                   placeholder="student@example.edu"
                   required />
        </div>

        <div style="margin-top:1rem;">
            <button type="submit"
                    class="btn-premium btn-primary">
                Add Student
            </button>
        </div>

    </form>
</div>