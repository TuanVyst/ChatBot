@page
@model ChatBot.Pages.Admin.CreateSubjectModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Subject";
}

<div class="admin-header">
    <h1 class="page-title">Create Subject</h1>

    <div class="admin-actions">
        <a asp-page="/Admin/Subjects" class="btn-secondary btn-premium">
            <i class="ph-bold ph-arrow-left"></i>
            Back to List
        </a>
    </div>
</div>

<div class="admin-card" style="max-width: 600px;">
    <form method="post" class="premium-form">

        <div class="form-group">
            <label asp-for="Subject.Name" class="form-label"></label>
            <input asp-for="Subject.Name" class="form-control" placeholder="Enter subject name..." />
            <span asp-validation-for="Subject.Name" class="text-danger" style="font-size: 0.85rem; margin-top: 4px;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Subject.Code" class="form-label"></label>
            <input asp-for="Subject.Code" class="form-control" placeholder="e.g., PRN222" />
            <span asp-validation-for="Subject.Code" class="text-danger" style="font-size: 0.85rem; margin-top: 4px;"></span>
        </div>

        <input type="hidden" asp-for="Subject.UniversityId" />

        <div class="form-group">
            <label asp-for="Subject.LectureAccountId" class="form-label">Assigned Lecture</label>
            <div style="position: relative;">
                <select asp-for="Subject.LectureAccountId" asp-items="Model.Teachers" class="form-control" style="appearance: none; padding-right: 2.5rem;">
                    <option value="">-- No Teacher Assigned --</option>
                </select>
                <i class="ph-bold ph-caret-down" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--text-muted);"></i>
            </div>
            <span asp-validation-for="Subject.LectureAccountId" class="text-danger" style="font-size: 0.85rem; margin-top: 4px;"></span>
        </div>

        <div style="margin-top: 1rem;">
            <button type="submit" class="btn-premium btn-primary">
                <i class="ph-bold ph-check"></i>
                Create Subject
            </button>
        </div>
    </form>
</div>