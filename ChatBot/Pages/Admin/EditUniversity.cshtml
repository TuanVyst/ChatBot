@page "{id:int}"
@model ChatBot.Pages.Admin.EditUniversityModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit University";
}

<div class="admin-header">
    <h1 class="page-title">Edit University</h1>

    <div class="admin-actions">
        <a asp-page="/Admin/Universities" class="btn-secondary btn-premium">
            <i class="ph-bold ph-arrow-left"></i>
            Back to List
        </a>
    </div>
</div>

<div class="admin-card" style="max-width: 600px;">

    <form method="post" class="premium-form">

        <input type="hidden" asp-for="University.Id" />

        <div class="form-group">
            <label asp-for="University.Name" class="form-label"></label>

            <input asp-for="University.Name"
                   class="form-control"
                   placeholder="Enter university name..." />

            <span asp-validation-for="University.Name"
                  class="text-danger"
                  style="font-size: 0.85rem; margin-top: 4px;">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="University.Code" class="form-label"></label>

            <input asp-for="University.Code"
                   class="form-control"
                   placeholder="e.g., FPTU" />

            <span asp-validation-for="University.Code"
                  class="text-danger"
                  style="font-size: 0.85rem; margin-top: 4px;">
            </span>
        </div>

        <div style="margin-top: 1rem;">
            <button type="submit" class="btn-premium btn-primary">
                <i class="ph-bold ph-floppy-disk"></i>
                Save Changes
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}