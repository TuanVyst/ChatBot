@page
@model ChatBot.Pages.Admin.CreateTeacherModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Teacher";
}

<div class="admin-header">
    <h1 class="page-title">Create Teacher Account</h1>

    <div class="admin-actions">
        <a asp-page="/Admin/Users" class="btn-secondary btn-premium">
            <i class="ph-bold ph-arrow-left"></i>
            Back to Users
        </a>
    </div>
</div>

<div class="admin-card" style="max-width: 600px;">

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert-premium alert-danger" style="margin-bottom:1.25rem;">
            <i class="ph-bold ph-warning-circle"></i>
            <span>@Model.Error</span>
        </div>
    }

    <form method="post" class="premium-form">

        <div class="form-group">
            <label asp-for="Teacher.Username" class="form-label"></label>
            <input asp-for="Teacher.Username" class="form-control" />
            <span asp-validation-for="Teacher.Username" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Teacher.Email" class="form-label"></label>
            <input asp-for="Teacher.Email" type="email" class="form-control" />
            <span asp-validation-for="Teacher.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Teacher.Password" class="form-label"></label>
            <input asp-for="Teacher.Password" type="password" class="form-control" />
            <span asp-validation-for="Teacher.Password" class="text-danger"></span>
        </div>

        <div style="margin-top:1rem;">
            <button type="submit" class="btn-premium btn-primary">
                <i class="ph-bold ph-user-plus"></i>
                Create Teacher
            </button>
        </div>

    </form>

</div>