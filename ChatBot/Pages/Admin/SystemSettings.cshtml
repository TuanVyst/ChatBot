@page
@model ChatBot.Pages.Admin.SystemSettingsModel

@{
    ViewData["Title"] = "System Settings";
}

<div class="admin-header">
    <h1 class="page-title">System Settings</h1>
</div>

<div class="admin-card" style="max-width:600px;">
    @if (TempData["Message"] != null)
    {
        <div class="notice success">@TempData["Message"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="notice danger">@TempData["Error"]</div>
    }

    <form method="post" class="premium-form">
        <div class="form-group">
            <label class="form-label">Chunk Size</label>
            <input asp-for="ChunkSize" class="form-control" />
        </div>

        <div class="form-group">
            <label class="form-label">Chunk Overlap</label>
            <input asp-for="ChunkOverlap" class="form-control" />
        </div>

        <div class="form-group">
            <label class="form-label">Top K</label>
            <input asp-for="TopK" class="form-control" />
        </div>

        <div class="form-group">
            <label class="form-label">Primary Embedding Model</label>
            <select asp-for="EmbeddingModel" class="form-control" style="cursor: pointer; padding: 10px;">
                <option value="gemini-embedding-2">gemini-embedding-2 (3072 dims - Mặc định)</option>
                <option value="gemini-embedding-2-preview">gemini-embedding-2-preview (3072 dims)</option>
                <option value="text-embedding-004">text-embedding-004 (768/3072 dims)</option>
            </select>
        </div>

        <div class="form-group">
            <label class="form-label">Backup Embedding Model</label>
            <select asp-for="BackupEmbeddingModel" class="form-control" style="cursor: pointer; padding: 10px;">
                <option value="None">None (Không sử dụng dự phòng)</option>
                <option value="gemini-embedding-2">gemini-embedding-2 (3072 dims)</option>
                <option value="gemini-embedding-2-preview">gemini-embedding-2-preview (3072 dims)</option>
                <option value="text-embedding-004">text-embedding-004 (768/3072 dims)</option>
            </select>
        </div>

        <button type="submit" class="btn-premium btn-primary" style="margin-top: 15px;">
            Save Settings
        </button>
    </form>
</div>