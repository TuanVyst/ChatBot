@using System.Linq
@model Tuple<BusinessObject.Entities.Document, IEnumerable<BusinessObject.Entities.DocumentChunk>>
@{
    var doc = Model?.Item1;
    var chunks = Model?.Item2;
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
    var downloadUrl = currentPath.Contains("Lecturer") 
        ? $"/Lecturer/Index?handler=Download&id={doc?.Id}" 
        : $"/Student/Chat?handler=Download&id={doc?.Id}";
}
<div style="margin-bottom:16px;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <div>
            <strong style="font-size:15px;">@doc?.FileName</strong>
            <span style="color:var(--text-muted);font-size:13px;margin-left:10px;">
                @(doc?.Subject?.Name ?? "Unknown") · @chunks?.Count() chunks
            </span>
        </div>
        @if (doc != null)
        {
            <a href="@downloadUrl" target="_blank" class="primary-btn" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;font-size:13px;text-decoration:none;border-radius:6px;background:var(--accent, #d89424);color:white;font-weight:600;transition:opacity 0.2s;" onmouseover="this.style.opacity=0.9" onmouseout="this.style.opacity=1">
                <i class="ph ph-download-simple" style="font-size:16px;"></i> Download File
            </a>
        }
    </div>
</div>

@if (chunks != null && chunks.Any())
{
    <div class="chunks-scroll-container" style="display:flex;flex-direction:column;gap:10px;max-height:460px;overflow-y:auto;padding-right:4px;">
        @foreach (var c in chunks)
        {
            <div id="chunk-@c.Id" data-chunk-order="@c.ChunkOrder" style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:16px; transition: all 0.3s;">
                <div style="font-weight:600;font-size:12px;color:var(--primary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">
                    Chunk @c.ChunkOrder
                </div>
                <div style="white-space:pre-wrap;line-height:1.7;font-size:14px;color:var(--text-dark);">
                    @Html.Raw(System.Net.WebUtility.HtmlEncode(c.Content))
                </div>
            </div>
        }
    </div>
}
else
{
    <div style="text-align:center;padding:40px 20px;color:var(--text-muted);">
        <i class="ph ph-file-x" style="font-size:40px;display:block;margin-bottom:12px;color:var(--text-light);"></i>
        <p>No chunks available for this document.</p>
    </div>
}
