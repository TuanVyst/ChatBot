@page "/Student/SubjectDetail/{id:guid}"
@model ChatBot.Pages.Student.SubjectDetailModel

@{
    ViewData["Title"] = "Subject Detail";
}

<div class="student-page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <a asp-controller="Student" asp-action="Dashboard" class="back-link" style="margin-bottom: 0;">← Back to Dashboard</a>
        <form asp-controller="Auth" asp-action="Logout" method="post" style="margin: 0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="secondary-btn" style="background: white; display: flex; align-items: center; gap: 8px; padding: 6px 12px; font-size: 14px;" title="Logout">
                <i class="ph ph-sign-out"></i> Logout
            </button>
        </form>
    </div>

    <div class="subject-header">
        <p class="eyebrow">@Model.SubjectDetail.Subject?.Code</p>
        <h1>@Model.SubjectDetail.Subject?.Name</h1>
        <p>Documents uploaded by lecturer for this subject.</p>
    </div>

    <h2>Documents</h2>

    @if (!Model.SubjectDetail.Documents.Any())
    {
        <div class="empty-box">
            <h3>No documents uploaded yet</h3>
            <p>Please wait for lecturer to upload learning materials.</p>
        </div>
    }
    else
    {
        <div class="document-list">
            @foreach (var doc in Model.SubjectDetail.Documents)
            {
                <div class="document-card">
                    <div>
                        <h3>@doc.FileName</h3>
                        <p>Chapter: @(doc.Chapter?.Name ?? "Default")</p>
                        <p>Status: @doc.IndexStatus</p>
                    </div>

                    <div class="document-actions">
                        <a asp-page-handler="Download" asp-route-id="@doc.Id"
                           class="secondary-btn">
                            Download
                        </a>

                        <a asp-controller="Student"
                           asp-action="Chat"
                           asp-route-subjectId="@Model.SubjectDetail.Subject?.Id"
                           asp-route-documentId="@doc.Id"
                           class="primary-btn">
                            Ask AI
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>