@page "/Student/Chat"
@model ChatBot.Pages.Student.ChatModel
@{
    ViewData["Title"] = "AI Learning Assistant";
    Layout = "~/Pages/Shared/_StudentLayout.cshtml";
}

<style>
    .modal-tabs {
        margin-left: 24px;
        margin-right: 24px;
    }
    .modal-tab-body-container {
        padding: 0 24px 24px 24px;
    }
    #chunksModalBody .chunks-scroll-container {
        max-height: none !important;
    }
    #chunksModalBody .primary-btn {
        display: none !important;
    }
</style>

<div class="chat-app">
    @* ═══════════ LEFT: CHAT HISTORY ═══════════ *@
    <aside class="chat-sidebar chat-history">
        <div class="chat-sidebar-header">
            <div class="chat-sidebar-title">
                <i class="ph ph-clock-counter-clockwise"></i>
                <span>Chat History</span>
            </div>
            <button type="button" class="new-chat-btn" id="newChatBtn" title="Start new conversation">
                <i class="ph ph-plus"></i>
            </button>
        </div>
        <div class="chat-history-list" id="chatHistoryList">
            <div class="chat-history-empty" id="chatHistoryEmpty">
                <i class="ph ph-chat-circle-dots"></i>
                <p>No chat history yet.<br />Start a new conversation!</p>
            </div>
        </div>
    </aside>

    @* ═══════════ CENTER: CHAT INTERFACE ═══════════ *@
    <main class="chat-main">
        <div class="chat-main-header">
            <div>
                <p class="chat-eyebrow">AI LEARNING ASSISTANT</p>
                <h1 class="chat-title">Hello, @Model.StudentChat.FullName 👋</h1>
                <p class="chat-subtitle">Ask me anything about your enrolled subjects and lecturer-uploaded documents.</p>
            </div>
            <div class="chat-header-actions" style="display: flex; align-items: center; gap: 8px;">
                <div style="background: rgba(245,158,11,0.1); color: #D97706; padding: 6px 12px; border-radius: 20px; font-weight: 500; font-size: 0.9rem; display: flex; align-items: center; gap: 4px;" title="Dung lượng token còn lại hôm nay">
                    <i class="ph ph-lightning"></i>
                    <span id="quotaDisplay">@Model.StudentChat.RemainingTokens.ToString("N0")</span>
                </div>
                <a href="/Student/Premium" class="chat-action-btn upgrade-btn" title="Upgrade to Premium" style="background-color: var(--primary); color: white; border-color: var(--primary); text-decoration: none;">
                    <i class="ph ph-crown"></i>
                    <span>Upgrade</span>
                </a>
                <a asp-page="/Student/Dashboard" class="chat-action-btn" title="Back to Dashboard">
                    <i class="ph ph-house"></i>
                    <span>Dashboard</span>
                </a>
                <form asp-page="/Auth/Logout" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="chat-action-btn chat-logout-btn" title="Logout">
                        <i class="ph ph-sign-out"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="chat-selectors">
            <div class="chat-selector">
                <label><i class="ph ph-book-open"></i> Subject</label>
                <select id="subjectSelect" class="chat-select">
                    <option value="">All Subjects</option>
                    @foreach (var sub in Model.StudentChat.Subjects)
                    {
                        <option value="@sub.Id" selected="@(Model.StudentChat.SelectedSubjectId == sub.Id)">@sub.Code — @sub.Name</option>
                    }
                </select>
            </div>
            <div class="chat-selector">
                <label><i class="ph ph-file-text"></i> Document</label>
                <select id="documentSelect" class="chat-select">
                    <option value="">All Documents</option>
                    @foreach (var doc in Model.StudentChat.Documents)
                    {
                        <option value="@doc.Id" data-subject="@doc.SubjectId" selected="@(Model.StudentChat.SelectedDocumentId == doc.Id)">
                            @doc.FileName
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="chat-messages" id="chatMessages">
            <div class="chat-message bot">
                <div class="chat-avatar"><i class="ph ph-robot"></i></div>
                <div class="chat-bubble">
                    <div class="chat-bubble-name">AI Assistant</div>
                    <div class="chat-bubble-text">
                        Hello! I'm your AI learning assistant. I can help you understand materials from your enrolled subjects. Ask me a question to get started! 🎓
                    </div>
                </div>
            </div>
        </div>

        <div class="chat-input-wrap">
            <div class="chat-suggestions" id="chatSuggestions">
                <button class="suggestion-chip" onclick="useSuggestion(this)">📚 Summarize the latest document</button>
                <button class="suggestion-chip" onclick="useSuggestion(this)">🧠 Explain the key concepts</button>
                <button class="suggestion-chip" onclick="useSuggestion(this)">❓ What is the main topic?</button>
            </div>
            <form class="chat-input-form" id="chatInputForm" onsubmit="return sendMessage(event)">
                @Html.AntiForgeryToken()
                <textarea id="chatInput" placeholder="Type your question here..." rows="1" onkeydown="handleKeyDown(event)"></textarea>
                <button type="submit" class="chat-send-btn" title="Send message">
                    <i class="ph ph-paper-plane-tilt"></i>
                </button>
            </form>
        </div>
    </main>

    @* ═══════════ RIGHT: DOCUMENTS ═══════════ *@
    <aside class="chat-sidebar chat-docs">
        <div class="chat-sidebar-header">
            <div class="chat-sidebar-title">
                <i class="ph ph-folder-open"></i>
                <span>Course Materials</span>
            </div>
            <span class="chat-doc-count" id="docCount">@Model.StudentChat.Documents.Count()</span>
        </div>
        <div class="chat-doc-filter">
            <input type="text" id="docSearch" placeholder="Search documents..." oninput="filterDocs(this.value)" />
            <i class="ph ph-magnifying-glass"></i>
        </div>
        <div class="chat-docs-list" id="chatDocsList">
            @if (!Model.StudentChat.Documents.Any())
            {
                <div class="chat-docs-empty">
                    <i class="ph ph-folder-open"></i>
                    <p>No documents available.<br />Documents uploaded by your lecturer will appear here.</p>
                </div>
            }
            else
            {
                @foreach (var doc in Model.StudentChat.Documents)
                {
                    <div class="chat-doc-card" data-subject="@doc.SubjectId" data-filename="@doc.FileName.ToLower()" onclick="openDocumentChunk(@doc.Id, null, null, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(doc.FileName))')" style="cursor: pointer;">
                        <div class="chat-doc-icon">
                            @{
                                var ext = System.IO.Path.GetExtension(doc.FileName)?.ToLower() ?? "";
                            }
                            @if (ext == ".pdf")
                            {
                                <i class="ph ph-file-pdf" style="color:#EF4444;"></i>
                            }
                            else if (ext == ".docx" || ext == ".doc")
                            {
                                <i class="ph ph-file-doc" style="color:#2563EB;"></i>
                            }
                            else if (ext == ".txt")
                            {
                                <i class="ph ph-file-text" style="color:#14B8A6;"></i>
                            }
                            else
                            {
                                <i class="ph ph-file" style="color:#475569;"></i>
                            }
                        </div>
                        <div class="chat-doc-info">
                            <div class="chat-doc-name" title="@doc.FileName">@doc.FileName</div>
                            <div class="chat-doc-meta">
                                <span><i class="ph ph-book-open"></i> @(doc.Subject?.Code ?? "—")</span>
                                <span><i class="ph ph-list"></i> @(doc.Chapter?.Name ?? "Default")</span>
                            </div>
                        </div>
                        <a asp-page="/Student/Chat" asp-page-handler="Download" asp-route-id="@doc.Id" target="_blank" class="chat-doc-download" title="Download original file" onclick="event.stopPropagation();">
                            <i class="ph ph-download-simple"></i>
                        </a>
                    </div>
                }
            }
        </div>
    </aside>
</div>

<!-- Chunks & Original Document Modal -->
<div id="chunksModal" class="modal-overlay">
    <div class="modal-box" style="max-width:90%; width:1000px; height:85vh; display:flex; flex-direction:column; overflow:hidden; background: white;">
        <div class="modal-header" style="margin-bottom: 10px; padding-bottom: 10px; flex-shrink: 0;">
            <h3 id="chunksModalTitle">Document Viewer</h3>
            <button class="modal-close" onclick="closeModal('chunksModal')">&times;</button>
        </div>

        <!-- Tab Headers -->
        <div class="modal-tabs" style="display:flex; justify-content: space-between; align-items: center; border-bottom:1px solid #e2e8f0; margin-bottom:12px; padding-bottom: 4px; flex-shrink: 0;">
            <div style="display:flex; gap:8px;">
                <button class="modal-tab-btn" id="tabBtnOriginal" onclick="switchModalTab('original')" style="background:none; border:none; padding:8px 16px; font-weight:600; cursor:pointer; color:var(--text-muted, #718096); border-bottom:2px solid transparent; transition:all 0.2s; font-family:inherit; font-size: 0.95rem;">
                    <i class="ph ph-file-text"></i> Tài liệu gốc
                </button>
                <button class="modal-tab-btn" id="tabBtnChunks" onclick="switchModalTab('chunks')" style="background:none; border:none; padding:8px 16px; font-weight:600; cursor:pointer; color:var(--text-muted, #718096); border-bottom:2px solid transparent; transition:all 0.2s; font-family:inherit; font-size: 0.95rem;">
                    <i class="ph ph-puzzle-piece"></i> Đoạn trích (Chunks)
                </button>
            </div>
            
            <a href="#" id="modalDownloadBtn" target="_blank" class="primary-btn" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;font-size:13px;text-decoration:none;border-radius:6px;background:var(--accent, #d89424);color:white;font-weight:600;transition:opacity 0.2s; font-family:inherit;" onmouseover="this.style.opacity=0.9" onmouseout="this.style.opacity=1">
                <i class="ph ph-download-simple" style="font-size:16px;"></i> Download File
            </a>
        </div>

        <!-- Tab Body Container -->
        <div class="modal-tab-body-container" style="flex:1; display:flex; flex-direction:column; overflow:hidden; position:relative; min-height: 0;">
            <!-- Tab 1: Original Document -->
            <div id="modalTabOriginal" style="display:none; flex-direction:column; height:100%; width:100%; overflow:hidden;">
                <iframe id="documentIframe" src="" style="width:100%; height:100%; border:none; flex:1; background: #f7fafc; border-radius: 8px;"></iframe>
                <div id="docxContainer" style="display:none; padding: 20px; background: white; height: 100%; overflow-y:auto; border-radius: 8px; border: 1px solid #e2e8f0; color: black;"></div>
            </div>
            
            <!-- Tab 2: Chunks -->
            <div id="modalTabChunks" style="display:none; flex-direction:column; height:100%; width:100%; overflow:hidden;">
                <div id="chunksModalBody" style="height:100%; overflow-y:auto;">
                    <p style="color:var(--text-muted);text-align:center;padding:40px;">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@* ═══════════ JAVASCRIPT ═══════════ *@
<script>
    // ── Document filter by subject ──
    document.getElementById('subjectSelect')?.addEventListener('change', function () {
        var subjectId = this.value;
        var docSelect = document.getElementById('documentSelect');
        Array.from(docSelect.options).forEach(function (opt) {
            if (!opt.value) { opt.hidden = false; return; }
            opt.hidden = (subjectId && opt.dataset.subject !== subjectId);
        });
        if (docSelect.options[docSelect.selectedIndex].hidden) docSelect.value = '';

        filterDocs(document.getElementById('docSearch').value);
        renderHistoryFromServer();
    });

    // ── Document search ──
    function filterDocs(q) {
        q = (q || '').toLowerCase();
        var subjectId = document.getElementById('subjectSelect').value;
        var visible = 0;
        document.querySelectorAll('.chat-doc-card').forEach(function (card) {
            var matchSubj = !subjectId || card.dataset.subject === subjectId;
            var matchName = !q || card.dataset.filename.indexOf(q) !== -1;
            if (matchSubj && matchName) {
                card.style.display = '';
                visible++;
            } else {
                card.style.display = 'none';
            }
        });
        document.getElementById('docCount').textContent = visible;
    }

    // ── Chat history (Database integrated) ──
    async function renderHistoryFromServer() {
        const subjectId = document.getElementById('subjectSelect').value || '';
        try {
            const res = await fetch('/Student/Chat?handler=History&subjectId=' + encodeURIComponent(subjectId));
            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    renderHistoryUI(data.history);
                }
            }
        } catch (e) {
            console.error("Error loading chat history:", e);
        }
    }

    function renderHistoryUI(history) {
        var list = document.getElementById('chatHistoryList');
        var empty = document.getElementById('chatHistoryEmpty');
        Array.from(list.querySelectorAll('.chat-history-item')).forEach(function (n) { n.remove(); });

        if (!history || history.length === 0) {
            empty.style.display = 'block';
            return;
        }
        empty.style.display = 'none';
        history.forEach(function (item) {
            var el = document.createElement('div');
            el.className = 'chat-history-item';
            el.innerHTML =
                '<div class="chat-history-item-title">' + escapeHtml(item.question || 'New chat') + '</div>' +
                '<div class="chat-history-item-meta">' +
                '<span><i class="ph ph-clock"></i> ' + (item.time || '') + '</span>' +
                '</div>';
            el.onclick = function () {
                loadChatHistoryItem(item);
            };
            list.appendChild(el);
        });
    }

    function escapeHtml(value) {
        var text = value == null ? '' : String(value);

        return text.replace(/[&<>"']/g, function (c) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[c];
        });
    }

    function formatMarkdownText(text) {
        var escaped = escapeHtml(text);
        // Bold: **text** -> <strong>text</strong>
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        // Inline code: `text` -> <code>text</code>
        escaped = escaped.replace(/`(.*?)`/g, '<code>$1</code>');
        // Newlines
        return escaped.replace(/\n/g, '<br/>');
    }

    function newChat() {
        var messages = document.getElementById('chatMessages');
        messages.innerHTML =
            '<div class="chat-message bot">' +
            '<div class="chat-avatar"><i class="ph ph-robot"></i></div>' +
            '<div class="chat-bubble">' +
            '<div class="chat-bubble-name">AI Assistant</div>' +
            '<div class="chat-bubble-text">New conversation started. Ask me anything about your enrolled subjects! 🎓</div>' +
            '</div>' +
            '</div>';
        renderHistoryFromServer();
    }

    function loadChatHistoryItem(item) {
        var messages = document.getElementById('chatMessages');
        messages.innerHTML = '';
        appendMessage(item.question, 'user', false);
        appendBotMessage(item.answer, item.sources, item.chunkSources);
    }

    // ── Send message ──
    async function sendMessage(e) {
        e.preventDefault();

        var input = document.getElementById('chatInput');
        var text = input.value.trim();

        if (!text) {
            return false;
        }

        appendMessage(text, 'user', true);

        input.value = '';
        autoResize();

        var typing = showTyping();

        // Tự hủy request sau 40 giây
        var controller = new AbortController();
        var timeoutId = setTimeout(function () {
            controller.abort();
        }, 40000);

        try {
            var subjectId =
                document.getElementById('subjectSelect').value || null;

            var documentIdValue =
                document.getElementById('documentSelect').value;

            var documentId = documentIdValue
                ? parseInt(documentIdValue, 10)
                : null;

            var tokenInput = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

            var headers = {
                'Content-Type': 'application/json'
            };

            if (tokenInput) {
                headers['RequestVerificationToken'] =
                    tokenInput.value;
            }

            var response = await fetch(
                '/Student/Chat?handler=Ask',
                {
                    method: 'POST',
                    headers: headers,
                    signal: controller.signal,
                    body: JSON.stringify({
                        question: text,
                        subjectId: subjectId,
                        documentId: documentId
                    })
                }
            );

            clearTimeout(timeoutId);
            removeTyping(typing);

            // Server trả 400, 401, 403, 500...
            if (!response.ok) {
                var errorText = await response.text();

                appendMessage(
                    'Lỗi server ' +
                    response.status +
                    ': ' +
                    (errorText || 'Không thể xử lý yêu cầu.'),
                    'bot',
                    true
                );

                return false;
            }

            var data = await response.json();

            if (data.success) {
                appendBotMessage(
                    data.answer || 'AI không trả về nội dung.',
                    data.sources || [],
                    data.chunkSources || []
                );

                await renderHistoryFromServer();
                
                var quotaSpan = document.getElementById('quotaDisplay');
                if (quotaSpan && typeof data.remainingTokens !== 'undefined') {
                    quotaSpan.textContent = data.remainingTokens.toLocaleString();
                }
            } else {
                appendMessage(
                    'Lỗi: ' +
                    (data.errorMessage ||
                        'Không thể tạo câu trả lời.'),
                    'bot',
                    true
                );
            }
        }
        catch (err) {
            clearTimeout(timeoutId);
            removeTyping(typing);

            if (err.name === 'AbortError') {
                appendMessage(
                    'Yêu cầu đã quá thời gian chờ. Gemini hoặc máy chủ phản hồi quá lâu.',
                    'bot',
                    true
                );
            } else {
                appendMessage(
                    'Lỗi kết nối đến máy chủ: ' + err.message,
                    'bot',
                    true
                );
            }
        }

        return false;
    }

    function showTyping() {
        var messages = document.getElementById('chatMessages');
        var el = document.createElement('div');
        el.className = 'chat-message bot typing';
        el.innerHTML =
            '<div class="chat-avatar"><i class="ph ph-robot"></i></div>' +
            '<div class="chat-bubble">' +
            '<div class="chat-bubble-name">AI Assistant</div>' +
            '<div class="chat-bubble-text"><div class="typing-dots"><span></span><span></span><span></span></div></div>' +
            '</div>';
        messages.appendChild(el);
        messages.scrollTop = messages.scrollHeight;
        return el;
    }

    function removeTyping(el) { if (el) el.remove(); }

    function appendMessage(text, role, scroll) {
        var messages = document.getElementById('chatMessages');
        var el = document.createElement('div');
        el.className = 'chat-message ' + role;
        var avatar = role === 'user'
            ? '<div class="chat-avatar user-avatar"><i class="ph ph-user"></i></div>'
            : '<div class="chat-avatar"><i class="ph ph-robot"></i></div>';
        var name = role === 'user' ? '@Model.StudentChat.FullName' : 'AI Assistant';
        el.innerHTML =
            avatar +
            '<div class="chat-bubble">' +
            '<div class="chat-bubble-name">' + escapeHtml(name) + '</div>' +
            '<div class="chat-bubble-text">' + formatMarkdownText(text) + '</div>' +
            '</div>';
        messages.appendChild(el);
        if (scroll) {
            messages.scrollTop = messages.scrollHeight;
        }
    }

    function appendBotMessage(text, sources, chunkSources) {
        var messages = document.getElementById('chatMessages');
        var el = document.createElement('div');
        el.className = 'chat-message bot';
        var avatar = '<div class="chat-avatar"><i class="ph ph-robot"></i></div>';
        var sourcesHtml = '';
        if (chunkSources && chunkSources.length > 0) {
            var uniqueChunks = [];
            var seen = {};
            for (var i = 0; i < chunkSources.length; i++) {
                var cs = chunkSources[i];
                if (!seen[cs.chunkId]) {
                    seen[cs.chunkId] = true;
                    uniqueChunks.push(cs);
                }
            }

            sourcesHtml = '<div class="chat-sources" style="margin-top: 10px; font-size: 0.85em; opacity: 0.95;">' +
                '<div class="sources-title" style="font-weight: 600; margin-bottom: 6px; color: var(--text-muted);"><i class="ph ph-link-simple"></i> Trích xuất từ tài liệu (Bấm để xem):</div>' +
                uniqueChunks.map(cs => 
                    '<button class="source-tag" onclick="openDocumentChunk(' + cs.documentId + ', ' + cs.chunkId + ', ' + cs.chunkOrder + ', \'' + cs.fileName.replace(/\'/g, "\\'") + '\')" style="display: inline-flex; align-items: center; gap: 4px; background: rgba(216, 148, 36, 0.08); color: #d89424; padding: 4px 8px; border-radius: 6px; margin-right: 8px; margin-bottom: 6px; border: 1px solid rgba(216, 148, 36, 0.2); cursor: pointer; font-size: 0.9em; font-family: inherit; transition: all 0.2s;" onmouseover="this.style.background=\'rgba(216, 148, 36, 0.15)\'" onmouseout="this.style.background=\'rgba(216, 148, 36, 0.08)\'">' +
                        '<i class="ph ph-file-text"></i> ' + escapeHtml(cs.fileName) + ' (Đoạn ' + cs.chunkOrder + ')' +
                    '</button>'
                ).join('') +
                '</div>';
        } else if (sources && sources.length > 0) {
            sourcesHtml = '<div class="chat-sources" style="margin-top: 10px; font-size: 0.85em; opacity: 0.8;"><div class="sources-title" style="font-weight: 600; margin-bottom: 4px; color: var(--text-muted);"><i class="ph ph-link-simple"></i> Nguồn tài liệu:</div>' +
                sources.map(s => '<span class="source-tag" style="display: inline-flex; align-items: center; gap: 4px; background: rgba(0,0,0,0.05); padding: 2px 8px; border-radius: 4px; margin-right: 6px; border: 1px solid rgba(0,0,0,0.1);"><i class="ph ph-file-text"></i> ' + escapeHtml(s) + '</span>').join('') +
                '</div>';
        }
        el.innerHTML =
            avatar +
            '<div class="chat-bubble">' +
            '<div class="chat-bubble-name">AI Assistant</div>' +
            '<div class="chat-bubble-text">' + formatMarkdownText(text) + sourcesHtml + '</div>' +
            '</div>';
        messages.appendChild(el);
        messages.scrollTop = messages.scrollHeight;
    }

    function useSuggestion(btn) {
        var text = btn.textContent.replace(/^[^\w]+/, '').trim();
        document.getElementById('chatInput').value = text;
        document.getElementById('chatInput').focus();
        autoResize();
    }

    function handleKeyDown(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();

            var form = document.getElementById('chatInputForm');

            if (form) {
                form.requestSubmit();
            }
        }
    }

    function autoResize() {
        var ta = document.getElementById('chatInput');
        ta.style.height = 'auto';
        ta.style.height = Math.min(ta.scrollHeight, 140) + 'px';
    }

    document.getElementById('chatInput')?.addEventListener('input', autoResize);
    document.getElementById('newChatBtn')?.addEventListener('click', newChat);
    
    function openModal(id) {
        var el = document.getElementById(id);
        if (el) el.classList.add('active');
    }

    function closeModal(id) {
        var el = document.getElementById(id);
        if (el) el.classList.remove('active');
    }

    function switchModalTab(tabName) {
        const tabBtnOriginal = document.getElementById('tabBtnOriginal');
        const tabBtnChunks = document.getElementById('tabBtnChunks');
        const tabOriginal = document.getElementById('modalTabOriginal');
        const tabChunks = document.getElementById('modalTabChunks');

        if (tabName === 'original') {
            tabBtnOriginal.style.borderBottom = '2px solid var(--primary, #d89424)';
            tabBtnOriginal.style.color = 'var(--primary, #d89424)';
            tabBtnChunks.style.borderBottom = '2px solid transparent';
            tabBtnChunks.style.color = 'var(--text-muted, #718096)';
            
            tabOriginal.style.display = 'flex';
            tabChunks.style.display = 'none';
        } else {
            tabBtnChunks.style.borderBottom = '2px solid var(--primary, #d89424)';
            tabBtnChunks.style.color = 'var(--primary, #d89424)';
            tabBtnOriginal.style.borderBottom = '2px solid transparent';
            tabBtnOriginal.style.color = 'var(--text-muted, #718096)';
            
            tabOriginal.style.display = 'none';
            tabChunks.style.display = 'flex';
        }
    }

    function viewOriginalDocument(docId, fileName) {
        const iframe = document.getElementById('documentIframe');
        const docxContainer = document.getElementById('docxContainer');

        if (fileName.toLowerCase().endsWith('.docx')) {
            iframe.style.display = 'none';
            docxContainer.style.display = 'block';
            docxContainer.innerHTML = '<div style="padding: 40px; text-align: center; color: var(--text-muted);"><i class="ph ph-spinner ph-spin" style="font-size: 24px; margin-bottom: 10px;"></i><br/>Loading document...</div>';

            fetch('/Student/Chat?handler=ViewOriginal&id=' + docId)
                .then(r => {
                    if (!r.ok) throw new Error('Không thể tải file docx.');
                    return r.arrayBuffer();
                })
                .then(buffer => {
                    mammoth.convertToHtml({ arrayBuffer: buffer })
                        .then(result => {
                            docxContainer.innerHTML = '<div class="docx-content" style="max-width: 800px; margin: 0 auto; color: black; line-height: 1.6;">' + result.value + '</div>';
                        })
                        .catch(err => {
                            console.error(err);
                            docxContainer.innerHTML = '<div style="padding: 40px; text-align: center; color: red;">Failed to render document.</div>';
                        });
                })
                .catch(err => {
                    console.error(err);
                    docxContainer.innerHTML = '<div style="padding: 40px; text-align: center; color: red;">Failed to load document.</div>';
                });
        } else {
            docxContainer.style.display = 'none';
            iframe.style.display = 'block';
            iframe.src = '/Student/Chat?handler=ViewOriginal&id=' + docId;
        }
    }

    function openDocumentChunk(documentId, chunkId, chunkOrder, fileName) {
        fileName = fileName || 'Nội dung tài liệu';
        document.getElementById('chunksModalTitle').innerText = fileName;
        document.getElementById('chunksModalBody').innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:40px;">Đang tải nội dung tài liệu...</p>';
        
        // Cập nhật link tải file
        var downloadBtn = document.getElementById('modalDownloadBtn');
        if (downloadBtn) {
            downloadBtn.href = '/Student/Chat?handler=Download&id=' + documentId;
        }

        // Default to Chunks tab if opening from a specific chunk click, otherwise show original document
        if (chunkId || chunkOrder) {
            switchModalTab('chunks');
        } else {
            switchModalTab('original');
        }

        // Trigger loading original document representation
        viewOriginalDocument(documentId, fileName);
        openModal('chunksModal');

        fetch('/Student/Chat?handler=Chunks&id=' + documentId)
            .then(r => {
                if (!r.ok) throw new Error('Không thể tải các đoạn trích.');
                return r.text();
            })
            .then(html => {
                document.getElementById('chunksModalBody').innerHTML = html;
                
                // Keep modal title updated
                var titleEl = document.getElementById('chunksModalBody').querySelector('strong');
                if (titleEl) {
                    document.getElementById('chunksModalTitle').innerText = titleEl.innerText;
                }

                // Find chunk to scroll and highlight
                var targetChunk = document.getElementById('chunk-' + chunkId);
                if (!targetChunk && chunkOrder) {
                    targetChunk = document.getElementById('chunksModalBody').querySelector('[data-chunk-order="' + chunkOrder + '"]');
                }

                if (targetChunk) {
                    targetChunk.style.border = '2px solid var(--accent, #d89424)';
                    targetChunk.style.background = 'rgba(216, 148, 36, 0.04)';
                    targetChunk.style.boxShadow = '0 4px 15px rgba(216, 148, 36, 0.1)';
                    
                    setTimeout(function() {
                        targetChunk.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }, 150);
                }
            })
            .catch(err => {
                document.getElementById('chunksModalBody').innerHTML = '<p style="color:red;text-align:center;padding:40px;">Lỗi: ' + err.message + '</p>';
            });
    }

    document.addEventListener('DOMContentLoaded', function () {
        var subjectSelect = document.getElementById('subjectSelect');
        if (subjectSelect && subjectSelect.value) {
            var subjectId = subjectSelect.value;
            var docSelect = document.getElementById('documentSelect');
            Array.from(docSelect.options).forEach(function (opt) {
                if (!opt.value) { opt.hidden = false; return; }
                opt.hidden = (subjectId && opt.dataset.subject !== subjectId);
            });
            if (docSelect.selectedIndex >= 0 && docSelect.options[docSelect.selectedIndex].hidden) docSelect.value = '';
        }

        renderHistoryFromServer();
        filterDocs('');
        
        document.querySelectorAll('.modal-overlay').forEach(function (el) {
            el.addEventListener('click', function (e) {
                if (e.target === el) {
                    closeModal(el.id);
                }
            });
        });
    });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.4.21/mammoth.browser.min.js"></script>

