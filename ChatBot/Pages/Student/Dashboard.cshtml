@page "/Student/Dashboard"
@model ChatBot.Pages.Student.DashboardModel

@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Pages/Shared/_StudentLayout.cshtml";
}

<div class="student-page">

    <div class="student-hero">

        <div>
            <p class="eyebrow">STUDENT PORTAL</p>

            <h1>Welcome, @Model.FullName</h1>

            <p>
                View subjects, read lecturer documents,
                download files, and ask AI about learning materials.
            </p>
        </div>

        <div style="display:flex; gap:12px; align-items:flex-start;">

            <a href="/Student/Chat"
               class="primary-btn"
               style="display:flex; align-items:center; gap:8px;">
                <i class="ph ph-chat-teardrop-dots"></i>
                Ask Chatbot
            </a>

            <form method="post"
                  asp-page="/Auth/Logout"
                  style="margin:0;">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="secondary-btn"
                        style="background:white; display:flex; align-items:center; gap:8px;"
                        title="Logout">

                    <i class="ph ph-sign-out"></i>
                    Logout
                </button>
            </form>

        </div>

    </div>

    <div id="notification-banner" style="display:none; margin-bottom: 20px;"></div>

    <h2>My Subjects</h2>

    @if (!Model.StudentDashboard.Subjects.Any())
    {
        <div class="empty-box">
            <h3>No subjects available</h3>
            <p>Please wait for admin to create subjects.</p>
        </div>
    }
    else
    {
        <div class="subject-grid" id="subject-list">

            @foreach (var subject in Model.StudentDashboard.Subjects)
            {
                <div class="subject-card">

                    <span>@subject.Code</span>

                    <h3>@subject.Name</h3>

                    <p>
                        View documents uploaded by lecturer.
                    </p>

                    <a asp-page="/Student/SubjectDetail"
                       asp-route-id="@subject.Id"
                       class="card-link">
                        Open subject
                    </a>

                </div>
            }

        </div>
    }

</div>

@section Scripts {
    <script>
        function showNotifications(notifications) {
            var banner = document.getElementById('notification-banner');
            if (!banner || !notifications || notifications.length === 0) return;

            var html = '';
            notifications.forEach(function (n) {
                var icon = n.type === 'enrolled' ? 'ph-user-plus' : 'ph-file-text';
                var bg = n.type === 'enrolled' ? 'rgba(34,197,94,0.1)' : 'rgba(37,99,235,0.1)';
                var border = n.type === 'enrolled' ? 'rgba(34,197,94,0.25)' : 'rgba(37,99,235,0.25)';
                var color = n.type === 'enrolled' ? '#16A34A' : '#2563EB';
                html += '<div style="display:flex;align-items:center;gap:10px;padding:12px 16px;margin-bottom:8px;'
                    + 'background:' + bg + ';border:1px solid ' + border + ';border-radius:10px;font-size:14px;color:' + color + ';">'
                    + '<i class="ph ' + icon + '" style="font-size:18px;flex-shrink:0;"></i>'
                    + '<span>' + n.message + '</span>'
                    + '</div>';
            });
            banner.innerHTML = html;
            banner.style.display = 'block';
        }

        function loadNotifications() {
            fetch('/Student/Dashboard?handler=Notifications')
                .then(function (r) { return r.json(); })
                .then(function (data) { showNotifications(data.notifications); })
                .catch(function () {});
        }

        window.refreshStudentData = function () {
            fetch(window.location.href)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var doc = new DOMParser().parseFromString(html, 'text/html');
                    var newList = doc.getElementById('subject-list');
                    var oldList = document.getElementById('subject-list');
                    if (newList && oldList) {
                        oldList.innerHTML = newList.innerHTML;
                    }
                });
        };

        document.addEventListener('DOMContentLoaded', function () {
            loadNotifications();
        });
    </script>
}