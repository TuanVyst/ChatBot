<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <!-- Phosphor Icons -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@@phosphor-icons/web@2.1.2/src/regular/style.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@@phosphor-icons/web@2.1.2/src/bold/style.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@@phosphor-icons/web@2.1.2/src/fill/style.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    
    <aside class="admin-sidebar">
        <a asp-controller="Admin" asp-action="Index" class="admin-brand">
            <i class="ph-fill ph-robot"></i>
            ChatBot Admin
        </a>

        <nav class="admin-nav">
            <a asp-controller="Admin" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                <i class="ph ph-squares-four"></i>
                Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Universities" class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString().Contains("Universit") == true ? "active" : "")">
                <i class="ph ph-buildings"></i>
                Universities
            </a>
            <a asp-controller="Admin" asp-action="Subjects" class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString().Contains("Subject") == true ? "active" : "")">
                <i class="ph ph-books"></i>
                Subjects
            </a>
            <a asp-controller="Admin" asp-action="Users" class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString().Contains("User") == true || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateTeacher" ? "active" : "")">
                <i class="ph ph-users"></i>
                Users
            </a>
        </nav>
        
        <div style="margin-top: auto; padding-top: 2rem;">
             <a asp-controller="Home" asp-action="Index" class="nav-item">
                <i class="ph ph-arrow-left"></i>
                Back to Site
            </a>
        </div>
    </aside>

    <main class="admin-main">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
