@model BusinessObject.Entities.University

@{
    ViewData["Title"] = "Create University";
}

<div class="admin-header">
    <h1 class="page-title">Create University</h1>
    <div class="admin-actions">
        <a asp-action="Universities" class="btn-secondary btn-premium">
            <i class="ph-bold ph-arrow-left"></i>
            Back to List
        </a>
    </div>
</div>

<div class="admin-card" style="max-width: 600px;">
    <form asp-action="CreateUniversity" method="post" class="premium-form">
        <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Enter university name..." />
            <span asp-validation-for="Name" class="text-danger" style="font-size: 0.85rem; margin-top: 4px;"></span>
        </div>
        
        <div class="form-group">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" placeholder="e.g., FPTU" />
            <span asp-validation-for="Code" class="text-danger" style="font-size: 0.85rem; margin-top: 4px;"></span>
        </div>
        
        <div style="margin-top: 1rem;">
            <button type="submit" class="btn-premium btn-primary">
                <i class="ph-bold ph-check"></i>
                Create University
            </button>
        </div>
    </form>
</div>
