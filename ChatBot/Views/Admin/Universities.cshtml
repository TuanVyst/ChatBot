@model IEnumerable<BusinessObject.Entities.University>

@{
    ViewData["Title"] = "Manage Universities";
}

<div class="admin-header">
    <h1 class="page-title">Universities</h1>
    <div class="admin-actions">
        <a asp-action="CreateUniversity" class="btn-premium btn-primary">
            <i class="ph-bold ph-plus"></i>
            Add University
        </a>
    </div>
</div>

<div class="admin-card">
    <table class="premium-table">
        <thead>
            <tr>
                <th>University Name</th>
                <th>Code</th>
                <th style="width: 150px; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div style="font-weight: 500; color: var(--text-main);">@item.Name</div>
                    </td>
                    <td>
                        <span style="background: rgba(0,0,0,0.05); padding: 4px 8px; border-radius: 6px; font-family: monospace; font-size: 0.85rem;">@item.Code</span>
                    </td>
                    <td>
                        <div class="table-actions" style="justify-content: flex-end;">
                            <a asp-action="EditUniversity" asp-route-id="@item.Id" class="btn-edit" title="Edit">
                                <i class="ph-bold ph-pencil-simple"></i>
                            </a>
                            <form asp-action="DeleteUniversity" asp-route-id="@item.Id" method="post" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this university?');">
                                <button type="submit" class="btn-danger" title="Delete" style="border: none; cursor: pointer;">
                                    <i class="ph-bold ph-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
