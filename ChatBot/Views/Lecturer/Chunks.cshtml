@using System.Linq
@model Tuple<BusinessObject.Entities.Document, IEnumerable<BusinessObject.Entities.DocumentChunk>>
@{
    ViewData["Title"] = "Document Chunks";
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
}

<div style="max-width:900px;margin:0 auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
        <div>
            <h1 style="font-size:24px;font-weight:700;">Chunks: @Model?.Item1?.FileName</h1>
            <p style="color:var(--text-muted);font-size:14px;margin-top:4px;">
                Subject: @(Model?.Item1?.Subject?.Name ?? "Unknown") · Uploaded: @Model?.Item1?.UploadDate.ToString("MMM dd, yyyy")
            </p>
        </div>
        <a asp-action="Index" asp-controller="Lecturer" class="btn-secondary" style="padding:10px 20px;text-decoration:none;font-size:14px;gap:8px;display:inline-flex;align-items:center;">
            <i class="ph ph-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (Model?.Item2 != null && Model.Item2.Any())
    {
        <div style="display:flex;flex-direction:column;gap:12px;">
            @foreach (var c in Model.Item2)
            {
                <div class="card" style="padding:18px;">
                    <div style="font-weight:600;font-size:13px;color:var(--text-muted);margin-bottom:8px;">Chunk @c.ChunkOrder</div>
                    <div style="white-space:pre-wrap;line-height:1.7;font-size:14px;color:var(--text-dark);">@Html.Raw(System.Net.WebUtility.HtmlEncode(c.Content))</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card empty-state">
            <i class="ph ph-file-x"></i>
            <p>No chunks available for this document.</p>
        </div>
    }
</div>