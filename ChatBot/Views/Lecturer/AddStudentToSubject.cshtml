@model BusinessObject.Entities.Subject
@{
    ViewData["Title"] = "Add Student";
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
}

<div style="max-width:560px;margin:0 auto;">
    <div style="margin-bottom:24px;">
        <a asp-action="Index" asp-controller="Lecturer" class="btn-secondary" style="padding:10px 20px;text-decoration:none;font-size:14px;gap:8px;display:inline-flex;align-items:center;margin-bottom:16px;">
            <i class="ph ph-arrow-left"></i> Back to Dashboard
        </a>
        <h1 style="font-size:24px;font-weight:700;">Add Student to @Model.Name</h1>
        <p style="color:var(--text-muted);font-size:14px;margin-top:4px;">Enroll a student in this subject by their email address.</p>
    </div>

    <div class="card" style="padding:24px;">
        <form asp-action="AddStudentToSubject" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="subjectId" value="@Model.Id" />
            <div class="form-group">
                <label class="form-label">Student Email</label>
                <input type="email" name="email" class="form-input" required placeholder="student@example.edu" />
            </div>
            <div style="display:flex;gap:10px;margin-top:8px;">
                <button type="submit" class="btn-primary btn-full" style="height:48px;">Add Student</button>
            </div>
        </form>
    </div>
</div>