@model ChatBot.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page">
    <header class="hero">
        <div class="hero-content">
            <span class="tag">RAG Chatbot</span>
            <h1>Bang dieu khien tai lieu</h1>
            <p>UI tam thoi de thu nhanh upload, liet ke va reindex tu MVC.</p>
            <div class="hero-actions">
                <a class="ghost" href="@Url.Action("Index", "Home")">Lam moi danh sach</a>
                <div class="api-badge">Host: <span>@Context.Request.Scheme://@Context.Request.Host</span></div>
            </div>
            <div class="stat-grid" aria-hidden="true">
                <div class="stat-card">
                    <span>Tai lieu</span>
                    <strong>@Model.Documents.Count</strong>
                    <em>Dang index</em>
                </div>
                <div class="stat-card">
                    <span>Subjects</span>
                    <strong>@Model.Subjects.Count</strong>
                    <em>Tu api/Subject</em>
                </div>
                <div class="stat-card">
                    <span>Hang doi</span>
                    <strong>@Model.PendingCount</strong>
                    <em>Pending</em>
                </div>
            </div>
        </div>
        <div class="hero-panel">
            <div class="panel-card">
                <h3>Ghi chu nhanh</h3>
                <ul>
                    <li>
                        <span>Upload</span>
                        <code>Home/Upload</code>
                    </li>
                    <li>
                        <span>Reindex</span>
                        <code>Home/Reindex</code>
                    </li>
                    <li>
                        <span>Filter</span>
                        <code>Home/Index?subjectName=</code>
                    </li>
                </ul>
                <div class="tip">
                    Tip: Upload xong se tu dong index. Ban co the bam Reindex neu can.
                </div>
            </div>
        </div>
    </header>

    <main class="layout">
        <section class="card">
            <div class="card-header">
                <h2>Upload tai lieu</h2>
                <span class="hint">Ho tro PDF, DOCX, TXT</span>
            </div>
            <form class="upload-form" asp-action="Upload" asp-controller="Home" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <label>
                    <span>Mon hoc</span>
                    <select name="subjectName" required>
                        <option value="">Chon mon hoc</option>
                        @foreach (var subject in Model.Subjects)
                        {
                            <option value="@subject" selected="@(subject == Model.SelectedSubject)">@subject</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Chapter</span>
                    <input type="text" name="chapterName" value="@Model.ChapterName" placeholder="Vi du: Chuong 1" />
                </label>
                <label class="file-input">
                    <span>File</span>
                    <input type="file" name="file" required />
                    <em>Chua chon file</em>
                </label>
                <button type="submit" id="uploadBtn">Upload va index</button>
                <div class="helper">
                    Kich thuoc toi da va dinh dang phu thuoc cau hinh server.
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="notice success">@Model.Message</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="notice error">@Model.Error</div>
            }
        </section>

        <section class="card">
            <div class="card-header">
                <div>
                    <h2>Danh sach tai lieu</h2>
                    <span class="hint">Tu MVC + Database</span>
                </div>
                <div class="filters">
                    <form method="get" asp-action="Index" asp-controller="Home">
                        <select name="subjectName" onchange="this.form.submit()">
                            <option value="">Tat ca mon hoc</option>
                            @foreach (var subject in Model.Subjects)
                            {
                                <option value="@subject" selected="@(subject == Model.SelectedSubject)">@subject</option>
                            }
                        </select>
                    </form>
                    <a class="ghost" href="@Url.Action("Index", "Home")">Tai lai</a>
                </div>
            </div>

            <div class="table">
                <div class="table-head">
                    <span>Tai lieu</span>
                    <span>Mon hoc</span>
                    <span>Chapter</span>
                    <span>Kich thuoc</span>
                    <span>Trang thai</span>
                    <span>Xu ly</span>
                </div>
                @if (Model.Documents.Count == 0)
                {
                    <div class="table-row empty">Chua co tai lieu nao.</div>
                }
                else
                {
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="table-row">
                            <div>
                                <strong>@doc.FileName</strong>
                                <span class="sub">@doc.UploadDate.ToString("g")</span>
                            </div>
                            <span>@doc.SubjectName</span>
                            <span>@(string.IsNullOrWhiteSpace(doc.ChapterName) ? "Default" : doc.ChapterName)</span>
                            <span>@(doc.FileSize == 0 ? "-" : string.Format("{0:0.##} MB", doc.FileSize / 1024d / 1024d))</span>
                            <span class="status @doc.IndexStatus.ToLower()">@doc.IndexStatus</span>
                            <form method="post" asp-action="Reindex" asp-controller="Home">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@doc.Id" />
                                <input type="hidden" name="subjectName" value="@Model.SelectedSubject" />
                                <button type="submit">Reindex</button>
                            </form>
                        </div>
                    }
                }
            </div>
            <div class="legend">
                <span class="chip completed">Completed</span>
                <span class="chip pending">Pending</span>
                <span class="chip failed">Failed</span>
            </div>

            <form action="/Auth/Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Đăng xuất</button>
            </form>
        </section>
    </main>
</div>
