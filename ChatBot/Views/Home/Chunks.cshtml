@using System.Linq
@model Tuple<BusinessObject.Entities.Document, IEnumerable<BusinessObject.Entities.DocumentChunk>>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Chunks for @Model.Item1.FileName</h2>
<p>Subject: @Model.Item1.Subject.Name | Uploaded: @Model.Item1.UploadDate.ToString("g")</p>

<div>
    <a asp-action="Index" asp-controller="Home">Back to Dashboard</a>
</div>

<section style="max-width:900px;margin:18px auto;padding:0 12px;">
    @foreach (var c in Model.Item2)
    {
        <article style="border:1px solid #e0e0e0;padding:18px;border-radius:8px;margin-bottom:16px;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,0.04);">
            <div style="font-weight:600;margin-bottom:10px;color:#333;">Chunk @c.ChunkOrder</div>
            <div style="white-space:pre-wrap;text-align:justify;text-justify:inter-word;line-height:1.6;color:#222;">@Html.Raw(System.Net.WebUtility.HtmlEncode(c.Content))</div>
        </article>
    }
</section>
