@model IEnumerable<BusinessObject.Entities.UserInformation>

<div class="students-list card">
    <div class="card-header">
        <h3>Danh sách sinh viên trong môn học</h3>
    </div>
    <div style="padding:12px;">
        @if (!Model?.Any() ?? true)
        {
            <div>Chưa có sinh viên nào.</div>
        }
        else
        {
            <ul style="list-style:none; padding:0; margin:0;">
                @foreach (var ui in Model)
                {
                    <li style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid #eee;">
                        <div>
                            <div style="font-weight:600;">@ui.Name</div>
                            <div style="font-size:0.9rem; color:#666;">@ui.Email</div>
                        </div>
                        <div>
                            <button class="btn-danger" onclick="removeStudent('@ui.Account_id')">Đá</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<script>
    function removeStudent(accountId) {
        if (!confirm('Bạn có chắc chắn muốn xóa sinh viên này khỏi môn học?')) return;
        
        var subjectId = document.querySelector('input[name="subjectId"]').value;
        var formData = new FormData();
        formData.append('accountId', accountId);
        formData.append('subjectId', subjectId);

        fetch('/Home/RemoveStudentFromSubject', {
            method: 'POST',
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
            body: formData
        }).then(r => r.json()).then(j => {
            alert(j.message);
            if (j.success) {
                viewStudentsList(); // Reload the list
            }
        }).catch(e => console.error(e));
    }
</script>
