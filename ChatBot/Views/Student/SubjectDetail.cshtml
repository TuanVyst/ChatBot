@model ChatBot.Models.StudentSubjectDetailViewModel

@{
    ViewData["Title"] = "Subject Detail";
}

<div class="student-page">
    <a asp-controller="Student" asp-action="Dashboard" class="back-link">← Back to Dashboard</a>

    <div class="subject-header">
        <p class="eyebrow">@Model.Subject?.Code</p>
        <h1>@Model.Subject?.Name</h1>
        <p>Documents uploaded by lecturer for this subject.</p>
    </div>

    <h2>Documents</h2>

    @if (!Model.Documents.Any())
    {
        <div class="empty-box">
            <h3>No documents uploaded yet</h3>
            <p>Please wait for lecturer to upload learning materials.</p>
        </div>
    }
    else
    {
        <div class="document-list">
            @foreach (var doc in Model.Documents)
            {
                <div class="document-card">
                    <div>
                        <h3>@doc.FileName</h3>
                        <p>Chapter: @(doc.Chapter?.Name ?? "Default")</p>
                        <p>Status: @doc.IndexStatus</p>
                    </div>

                    <div class="document-actions">
                        <a asp-controller="Student"
                           asp-action="Download"
                           asp-route-id="@doc.Id"
                           class="secondary-btn">
                            Download
                        </a>

                        <a asp-controller="Student"
                           asp-action="Chat"
                           asp-route-subjectId="@Model.Subject?.Id"
                           asp-route-documentId="@doc.Id"
                           class="primary-btn">
                            Ask AI
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>