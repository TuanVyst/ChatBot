@model ChatBot.Models.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="student-page">
    <div class="student-hero">
        <div>
            <p class="eyebrow">STUDENT PORTAL</p>
            <h1>Welcome, @Context.Session.GetString("FullName")</h1>
            <p>View subjects, read lecturer documents, download files, and ask AI about learning materials.</p>
        </div>

        <a asp-controller="Student" asp-action="Chat" class="primary-btn">Ask Chatbot</a>
    </div>

    <h2>My Subjects</h2>

    @if (!Model.Subjects.Any())
    {
        <div class="empty-box">
            <h3>No subjects available</h3>
            <p>Please wait for admin to create subjects.</p>
        </div>
    }
    else
    {
        <div class="subject-grid">
            @foreach (var subject in Model.Subjects)
            {
                <div class="subject-card">
                    <span>@subject.Code</span>
                    <h3>@subject.Name</h3>
                    <p>View documents uploaded by lecturer.</p>

                    <a asp-controller="Student"
                       asp-action="SubjectDetail"
                       asp-route-id="@subject.Id"
                       class="card-link">
                        Open subject
                    </a>
                </div>
            }
        </div>
    }
</div>